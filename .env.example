# Public — safe to expose to the browser. From Supabase Dashboard -> Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public — the site's canonical production URL, no trailing slash. Only used
# for robots.txt/sitemap.xml (src/app/robots.ts, src/app/sitemap.ts), which
# need an absolute domain and have no per-request origin to derive one from
# the way Server Actions do (src/app/actions/auth.ts's requestOrigin()).
# Falls back to http://localhost:3000 if unset, which is fine in dev.
NEXT_PUBLIC_SITE_URL=https://asyashare.example.com

# Secret — server-only. Used by the seed script and admin tooling. NEVER
# prefix this with NEXT_PUBLIC_ or import it into client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secret — server-only. Set as a Supabase Edge Function secret (not here) once
# the identifier-scan function is deployed. Listed here for reference.
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Secret — server-only. From resend.com/api-keys, used by src/lib/email.ts to
# send the verification approved/rejected emails from approveUserAction and
# rejectUserAction (src/app/actions/admin.ts). Without it, those emails are
# skipped (logged, not sent) — the moderation decision itself still saves.
# With a free Resend account and no verified sending domain, delivery only
# reaches the email address the Resend account itself was created with;
# verify a domain in the Resend dashboard to send to real applicants.
RESEND_API_KEY=your-resend-api-key

# Web Push (VAPID) — self-generated, no external account needed. Generate a
# pair with `npx web-push generate-vapid-keys` and set the same values here
# and in the deployment's env (e.g. Vercel). The public key is also read by
# the browser (src/components/push-notification-toggle.tsx) to open a
# PushManager subscription, so it's duplicated under a NEXT_PUBLIC_ name.
# Without these, sendPushToUsers (src/lib/web-push.ts) logs and no-ops —
# in-app notifications still work.
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
# mailto: address Web Push services may contact if a subscription is abused.
VAPID_SUBJECT=mailto:you@example.com
